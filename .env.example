# ========== 复制本文件为 .env 后填写 ==========
#     copy .env.example .env      (Windows CMD)
#     cp .env.example .env        (Git Bash / PowerShell)

# ---------- 大模型：二选一 ----------
# deepseek = 云端 API；ollama = 本地模型
LLM_PROVIDER=deepseek

# 【方案A】DeepSeek 云端： https://platform.deepseek.com 注册后创建 API Key
DEEPSEEK_API_KEY=sk-你的key填这里
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 【方案B】本地 Ollama：先 `ollama serve`，再 `ollama pull qwen2.5:7b`
# 把上面 LLM_PROVIDER 改成 ollama 即可，下面两行生效
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ---------- 联网搜索 ----------
# 搜索链（自动降级）：高德POI(配Key即启用,真实商家+评分+人均) → DDG/OSM(免费联网) → 离线数据池(兜底)
SEARCH_PROVIDER=auto

# 高德 Web 服务 Key： https://console.amap.com/dev/key/app  （个人开发者免费）
# 创建应用 -> 添加Key -> 服务平台选「Web服务」
# 【联网搜索关键】配好后自动启用高德POI搜索，返回真实商家(名字/地址/评分/人均/距离)
# 不填则跳过高德，尝试 DDG/OSM 免费联网（国内网络可能不通），最终降级离线数据
AMAP_KEY=

# OSM Overpass 真实周边搜索开关（免费无需Key，国内网络可能超时）
# 演示现场网络不通时设 0 可跳过OSM等待
OSM_SEARCH_ENABLED=1

SEARCH_RADIUS_M=5000
SEARCH_LIMIT=5

# ---------- 服务 ----------
HOST=127.0.0.1
PORT=5000
DEBUG=1
